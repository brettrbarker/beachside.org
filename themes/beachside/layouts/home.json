[
{{- $pages := where site.RegularPages "Params.noindex" "ne" true -}}
{{- range $index, $page := $pages -}}
  {{- if $index }},{{ end }}
  {"title":{{ $page.Title | jsonify }},"url":{{ $page.RelPermalink | jsonify }},"description":{{ ($page.Description | default $page.Summary | plainify) | jsonify }}}
{{- end -}}
]
