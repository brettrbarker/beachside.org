[
{{- $first := true -}}
{{- range $page := site.Pages -}}
  {{- $isMessageSeries := and (eq $page.Kind "section") (eq $page.Layout "series") -}}
  {{- if and (ne $page.Params.noindex true) (or (eq $page.Kind "page") $isMessageSeries) -}}
  {{- if not $first }},{{ end }}
  {"title":{{ $page.Title | jsonify }},"url":{{ $page.RelPermalink | jsonify }},"description":{{ ($page.Description | default $page.Summary | plainify) | jsonify }}}
  {{- $first = false -}}
  {{- end -}}
{{- end -}}
]
